{
    "tasks": [
        {
            "type": "process",
            "label": "Build, push, and release Windows executable",
            "command": "bash",
            "args": [
                "${workspaceFolder}/build-and-release.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Clean-builds GptToMbr.exe, commits tracked changes, pushes the current branch, and publishes the next patch-version GitHub release."
        }
    ],
    "version": "2.0.0"
}